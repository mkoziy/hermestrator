# Template for dashboard configuration. Copy to an ignored `.env` file and
# provide it to `docker run --env-file`; do not commit real credentials.

# GitHub automation identity. This is not an operator login.
GH_TOKEN=
# Identity for commits created by executors.
GIT_USER_NAME=
GIT_USER_EMAIL=

# GitHub OAuth application used for dashboard sign-in.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
PM_JWT_SECRET=
PM_ALLOWED_GITHUB_USERS=

# Genkit/OpenRouter model configuration.
OPENROUTER_API_KEY=
PM_MODEL_DISCOVERY=openai/gpt-4.1-mini
# PM_MODEL_REVIEW_STANDARDS=
# PM_MODEL_REVIEW_SPEC=
# PM_MODEL_CRITIQUE=

# Dashboard and durable state.
PM_DASHBOARD_URL=http://localhost:8080
PM_LISTEN_ADDR=:8080
PM_SQLITE_PATH=/data/pm.db

# Optional Telegram notification delivery.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# PM-owned workspaces and executor configuration. Mount durable directories
# for these values in deployed environments.
# PM_INTAKE_DIR=/data/intakes
# PM_ISSUE_WORKSPACE_DIR=/data/issues
# PM_EXECUTOR_WORKSPACE_DIR=/data/executor-workspaces
# PM_PLANNING_PROFILE=/data/planning-profile.json
# PM_RALPHEX_PLANNING_CONFIG_DIR=/data/ralphex-planning
# PM_RALPHEX_EXECUTION_CONFIG_DIR=/data/ralphex-execution
